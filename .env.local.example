# Zkopíruj tenhle soubor jako `.env.local` a vyplň hodnoty.
# `.env.local` je v .gitignore, takže se nikdy nedostane do repozitáře.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" — smí do prohlížeče, chrání ho přístupová práva v databázi
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" — obchází VŠECHNA přístupová práva. Nikdy nesmí do prohlížeče
# ani do repozitáře. Používá se jen pro veřejnou stránku sdíleného reportu.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI — stačí jeden, aplikace nabídne jen ty, ke kterým má klíč
# ---------------------------------------------------------------------------
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# aistudio.google.com → Get API key
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Adresa aplikace — kam se vrací přihlašovací odkaz z e-mailu
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
