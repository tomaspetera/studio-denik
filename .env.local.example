# Zkopíruj tenhle soubor jako `.env.local` a vyplň hodnoty.
# `.env.local` je v .gitignore, takže se nikdy nedostane do repozitáře.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" — smí do prohlížeče, chrání ho přístupová práva v databázi
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" — obchází VŠECHNA přístupová práva. Nikdy nesmí do prohlížeče
# ani do repozitáře. Používá se jen pro veřejnou stránku sdíleného reportu.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI — stačí jeden, aplikace nabídne jen ty, ke kterým má klíč
# ---------------------------------------------------------------------------
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# aistudio.google.com → Get API key
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Adresa aplikace — kam se vrací přihlašovací odkaz z e-mailu
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Push notifikace — ranní souhrn a upozornění na termíny do telefonu.
# Nepovinné: bez nich appka funguje úplně stejně, jen se tlačítko "Zapnout
# upozornění" nezobrazí. VAPID_PUBLIC_KEY smí do prohlížeče (posílá se jím
# jen "tohle je legitimní server", nejde jím nic přečíst) — proto NEXT_PUBLIC.
# VAPID_PRIVATE_KEY ani CRON_SECRET do prohlížeče ani do repozitáře nesmí.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Náhodný řetězec (aspoň 16 znaků) — Vercel ho sám posílá jako hlavičku
# při spuštění naplánované úlohy, cron endpoint tím pozná, že žádost
# opravdu přišla od Vercelu, ne od kohokoli, kdo tu adresu uhodne.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Gmail — čtení pošty (nepovinné: bez těchto klíčů appka funguje stejně,
# jen se nenabídne připojení Gmailu).
#
# Z Google Cloud: projekt → Google Auth Platform → Clients → typ "Web
# application". Do "Authorized redirect URIs" patří {adresa}/api/gmail/callback
# pro produkci i pro localhost. Aplikace žádá jediné oprávnění
# gmail.readonly, tedy jen čtení — nikdy nic neodesílá ani nemaže.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Klíč, kterým se šifruje uložené přihlášení ke Gmailu, aby v databázi
# neleželo čitelně. Vyrob si vlastní náhodný (32 bajtů v base64), třeba:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_TOKEN_KEY=
